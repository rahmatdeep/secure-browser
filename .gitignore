postgres_data/

# Raw video masters. Candidate clips are kept in apps/frontend/public so they
# can be compared in place, but the exports are hundreds of MB — committing one
# is effectively permanent, since removing it later means rewriting history.
# Only the transcoded hero.mp4 and its poster belong in git.
apps/frontend/public/*.mov
apps/frontend/public/*-master.*

# Candidate clips that were never wired up. Kept on disk for reference, but
# they are not referenced by any branch's source, so they are local-only.
apps/frontend/public/hero1.mp4

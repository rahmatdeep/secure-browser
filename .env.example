# -----------------------------------------------------------------------------
# Optional Environment Overrides for Secure Browser
# -----------------------------------------------------------------------------
# When running with Docker Compose, all variables below have safe internal
# defaults built into docker-compose.yml. You only need to define them here if you
# want to override the defaults (e.g. for a production deployment).
# -----------------------------------------------------------------------------

# PostgreSQL Container Credentials (Optional override)
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your_custom_secure_password
# POSTGRES_DB=secure_browser

# Complete Database Connection URL (Optional override)
# For Docker Compose: "postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}"
# For External DB (e.g. Supabase/RDS): "postgresql://user:pass@db.example.com:5432/dbname?sslmode=require"
# DATABASE_URL="postgresql://postgres:your_custom_secure_password@postgres:5432/secure_browser"

# Ports & Hosts (Optional overrides)
# PORT=3001
# FRONTEND_PORT=3000
# FRONTEND_URL=http://localhost:3000
# NEXT_PUBLIC_API_URL=http://localhost:3001
# HOST_IP=localhost

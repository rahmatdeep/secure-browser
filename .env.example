# PostgreSQL Container Credentials (used to initialize the database)
POSTGRES_USER=secure_user
POSTGRES_PASSWORD=replace_with_a_secure_password
POSTGRES_DB=secure_browser

# Complete Database Connection URL (used by Prisma and Backend)
# For Docker Compose: "postgresql://<USER>:<PASSWORD>@postgres:5432/<DB>"
# For External DB: "postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DB>?sslmode=require"
DATABASE_URL="postgresql://secure_user:replace_with_a_secure_password@postgres:5432/secure_browser"

# Ports & Hosts
PORT=3001
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
HOST_IP=localhost
